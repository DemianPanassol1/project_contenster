# =========================================================
# Server-side API client
# =========================================================
# Base URL used by Next.js server code. It must include the API prefix and version.
WEB_API_URL=http://localhost:8080/api/v1

# Maximum duration, in milliseconds, for an API request made by the Web server.
WEB_API_TIMEOUT_MS=30000

# =========================================================
# Application metadata shown in the administrative footer
# =========================================================
WEB_APP_ENVIRONMENT=local
WEB_APP_VERSION=0.0.0
