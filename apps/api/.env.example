# =========================================================
# Runtime
# =========================================================
NODE_ENV=development
PORT=8080
APP_NAME=Contenster Slim Core API
# Public API origin. Local files are returned with this origin, such as http://localhost:8080/uploads/...
APP_URL=http://localhost:8080
# Fixed operational timezone used for PostgreSQL timestamps and HTTP date-time responses.
# This is not configurable by clients or users.
APP_TIMEZONE=America/Sao_Paulo
API_PREFIX=api
API_VERSION=1

# =========================================================
# PostgreSQL
# =========================================================
# The API always uses PostgreSQL's public schema. There is no schema selection
# by client, request or browser session.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=contenster_slim_core
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=10

# =========================================================
# Redis and sessions
# =========================================================
# Redis support is configured here and will be connected with the authentication
# session implementation.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_RECONNECT_MAX_RETRIES=3
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAX_DELAY_MS=1000
REDIS_RECONNECT_COOLDOWN_MS=5000
SESSION_HMAC_SECRET=
SESSION_COOKIE_NAME=contenster_session
SESSION_KEY_PREFIX=contenster:auth
SESSION_NORMAL_TTL_SECONDS=3600
SESSION_REMEMBERED_TTL_SECONDS=2592000
SESSION_ACTIVITY_UPDATE_INTERVAL_SECONDS=300

# Password recovery tokens. Use a secret distinct from SESSION_HMAC_SECRET.
PASSWORD_RESET_TOKEN_SECRET=
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m
PASSWORD_RESET_TOKEN_ISSUER=contenster-slim-core
PASSWORD_RESET_TOKEN_AUDIENCE=contenster-slim-core-password-reset

# SMTP used exclusively by password recovery.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Contenster Slim Core
MAIL_FROM_ADDRESS=

# =========================================================
# HTTP and documentation
# =========================================================
# Keep empty when the API is consumed only through the server-side Web flow.
CORS_ORIGIN=
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
SWAGGER_ENABLED=true
# Full route from the API host: http://localhost:8080/api/v1/docs
SWAGGER_PATH=/api/v1/docs
SWAGGER_PERSIST_AUTHORIZATION=true

# =========================================================
# Logs and media
# =========================================================
LOG_LEVEL=info
LOG_PRETTY=true
MAX_UPLOAD_FILE_SIZE_BYTES=26214400
UPLOADS_LOCAL_ROOT_PATH=writable/uploads
UPLOADS_PUBLIC_BASE_URL=/uploads
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
STORAGE_CREDENTIALS_ENCRYPTION_KEY=

# Request and task log retention (days)
REQUEST_LOG_RETENTION_INFO_DAYS=7
REQUEST_LOG_RETENTION_WARNING_DAYS=28
REQUEST_LOG_RETENTION_ERROR_DAYS=90
REQUEST_LOG_RETENTION_FATAL_DAYS=180
CRON_LOG_RETENTION_DAYS=90

# Scheduled maintenance (five-field cron expressions, evaluated in the server timezone)
CRON_LOG_CLEANUP_CRON=30 */6 * * *
FILE_CLEANUP_CRON=0 */6 * * *
FILE_CLEANUP_SAFETY_WINDOW_MINUTES=15
