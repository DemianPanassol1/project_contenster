# Copy this file to .env.test and use isolated local test services.
NODE_ENV=test
PORT=8081
APP_NAME=Contenster Slim Core API Test
API_PREFIX=
API_VERSION=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=contenster_slim_core_test
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_MAX=5
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
SESSION_HMAC_SECRET=test-session-hmac-secret-not-for-production-123456789
STORAGE_CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
REQUEST_LOG_RETENTION_INFO_DAYS=7
REQUEST_LOG_RETENTION_WARNING_DAYS=28
REQUEST_LOG_RETENTION_ERROR_DAYS=90
REQUEST_LOG_RETENTION_FATAL_DAYS=180
CRON_LOG_RETENTION_DAYS=90
CRON_LOG_CLEANUP_CRON=30 */6 * * *
FILE_CLEANUP_CRON=0 */6 * * *
FILE_CLEANUP_SAFETY_WINDOW_MINUTES=15
SWAGGER_ENABLED=false
