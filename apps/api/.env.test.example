# Copy this file to .env.test and use isolated local test services.
NODE_ENV=test
PORT=8081
APP_NAME=Contenster Slim Core API Test
API_PREFIX=
API_VERSION=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=contenster_slim_core_test
