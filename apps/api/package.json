{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "migration:generate": "pnpm run build && node dist/database/migrate.js generate",
    "migration:show": "pnpm run build && node dist/database/migrate.js show",
    "migration:run": "pnpm run build && node dist/database/migrate.js run",
    "migration:revert": "pnpm run build && node dist/database/migrate.js revert",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:unit": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:smoke": "vitest run test/e2e/app.e2e-spec.ts",
    "test:unit:cov": "vitest run src --coverage --coverage.reportsDirectory=coverage/unit",
    "test:integration:cov": "vitest run --config vitest.integration.config.mts --coverage --coverage.reportsDirectory=coverage/integration",
    "test:e2e:cov": "vitest run --config vitest.e2e.config.mts --coverage --coverage.reportsDirectory=coverage/e2e",
    "test:cov": "pnpm run test:unit:cov && pnpm run test:integration:cov && pnpm run test:e2e:cov"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@contenster/shared": "workspace:*",
    "@google-cloud/storage": "8.4.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "dompurify": "3.4.17",
    "dotenv": "18.0.8",
    "helmet": "8.3.0",
    "jsdom": "30.1.2",
    "nestjs-i18n": "10.8.5",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/compression": "1.8.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5"
  }
}
